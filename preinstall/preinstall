# DESCRIPTION
# Postinstall script for Jamf Notifier
#
##########################################################################################

# Check to see if Notifier is installed...
if [ -d '/Applications/Utilities/Notifier.app' ]
then
    # Get the bundle id....
    bundleId=$(/usr/bin/defaults read /Applications/Utilities/Notifier.app/Contents/info.plist CFBundleIdentifier || true)
    # If `bundleId` isn't `com.jamf.notifier`...
    if [ "${bundleId}" != "com.jamf.notifier" ]
    then
        # Delete Notifier.app
        /bin/rm -rf /Applications/Utilities/Notifier.app
        # Log.
        /bin/echo "Deleted: /Applications/Utilities/Notifier.app..."
    fi
fi
