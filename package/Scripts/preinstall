#
##########################################################################################
#
# DESCRIPTION
# Preinstall script for Jamf Notifier
#
##########################################################################################

# Var declarations
app_path='/Applications/Utilities/Notifier.app'

# Check to see if `app_path` is installed...
if [ -d "${app_path}" ]
then
    # Get the bundle id....
    bundleId=$(/usr/bin/defaults read ${app_path}/Contents/info.plist CFBundleIdentifier || true)
    # If `bundleId` isn't `com.jamf.notifier`...
    if [ "${bundleId}" != "com.jamf.notifier" ]
    then
        # Delete Notifier.app
        /bin/rm -rf "${app_path}"
        # Log.
        /bin/echo "Deleted: ${app_path}..."
    fi
fi
